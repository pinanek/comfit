{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "generated/**/*.ts", "tsdown.config.ts"]
}
