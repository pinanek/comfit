{
  "excludes": [
    "**/node_modules",
    "**/target",
    "**/dist",
    ".grammars",
    "crates/comfit_grammars/data",
    "crates/comfit_themes/data",
    "docs/src/pages.gen.ts",
    "npm/wasm/js/generated",
    "npm/wasm-grammars/generated",
    "**/*-lock.json"
  ],
  "markup": {
    "indentWidth": 2
  },
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "rustfmt --edition 2024",
        "exts": ["rs"]
      }
    ]
  },
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
    "npm:dprint-plugin-markup@0.27.5"
  ]
}
