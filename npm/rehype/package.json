{
  "name": "@comfit/rehype",
  "version": "0.1.0",
  "description": "Comfit plugin for highlighting code blocks with rehype",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinanek/comfit.git",
    "directory": "npm/rehype"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "cargo notices build rehype && pnpm bundle",
    "bundle": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "cargo notices check rehype",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@comfit/node": "workspace:^",
    "@types/hast": "catalog:",
    "hast-util-from-html": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
