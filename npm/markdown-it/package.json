{
  "name": "@comfit/markdown-it",
  "version": "0.1.0",
  "description": "Comfit plugin for highlighting fenced code blocks with markdown-it",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinanek/comfit.git",
    "directory": "npm/markdown-it"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "LICENSE"],
  "scripts": {
    "build": "cargo notices build markdown-it && pnpm bundle",
    "bundle": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "cargo notices check markdown-it"
  },
  "dependencies": {
    "@comfit/node": "workspace:^",
    "@types/markdown-it": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "markdown-it": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "markdown-it": "^14.0.0 || ^15.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
